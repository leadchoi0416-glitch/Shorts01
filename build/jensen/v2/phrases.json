[
 {
  "text": "에이아이 황제가,",
  "start": 0.15,
  "end": 1.23
 },
 {
  "text": "하루아침에 물러났다?",
  "start": 1.36,
  "end": 2.61
 },
 {
  "text": "젠슨 황에게,",
  "start": 3.16,
  "end": 4.14
 },
 {
  "text": "무슨 일이 있었던 걸까요?",
  "start": 4.31,
  "end": 5.62
 },
 {
  "text": "십일월 십일일,",
  "start": 6.17,
  "end": 7.1
 },
 {
  "text": "엔비디아 이사회가 젠슨 황의 사임을 수리했습니다.",
  "start": 7.51,
  "end": 10.67
 },
 {
  "text": "천구백구십삼 년 회사를 세운 지,",
  "start": 11.22,
  "end": 13.3
 },
 {
  "text": "삼십삼 년 만입니다.",
  "start": 13.47,
  "end": 14.74
 },
 {
  "text": "발단은 혼외 관계 의혹입니다.",
  "start": 15.29,
  "end": 17.49
 },
 {
  "text": "황 전 씨이오는 직원들에게 보낸 메시지에서,",
  "start": 18.04,
  "end": 20.86
 },
 {
  "text": "불륜을 인정했습니다.",
  "start": 21.08,
  "end": 22.4
 },
 {
  "text": "다만 상대 여성이 중국 정보기관과 연관됐다는 보도에 대해선,",
  "start": 22.95,
  "end": 27.26
 },
 {
  "text": "국가 안보나 회사 기밀을 훼손한 적은 없다고 부인했습니다.",
  "start": 27.58,
  "end": 31.37
 },
 {
  "text": "시장은 곧바로 반응했습니다.",
  "start": 31.92,
  "end": 33.8
 },
 {
  "text": "엔비디아 주가는 장 초반,",
  "start": 34.35,
  "end": 36.09
 },
 {
  "text": "십오 퍼센트 가까이 급락했고,",
  "start": 36.3,
  "end": 38.15
 },
 {
  "text": "한 달 새 이십오 퍼센트 정도가 빠졌습니다.",
  "start": 38.47,
  "end": 41.2
 },
 {
  "text": "임시 씨이오에는 콜레트 크레스 최고재무책임자가 선임됐고,",
  "start": 41.75,
  "end": 45.78
 },
 {
  "text": "미국 하원 세 개 위원회는,",
  "start": 46.13,
  "end": 47.81
 },
 {
  "text": "십이월 일일 비공개 면담을 요구했습니다.",
  "start": 48.06,
  "end": 50.77
 },
 {
  "text": "중국은 스파이 서사를 조작한다며,",
  "start": 51.32,
  "end": 53.53
 },
 {
  "text": "강하게 반발했습니다.",
  "start": 53.73,
  "end": 55.02
 },
 {
  "text": "그런데 반전이 있습니다.",
  "start": 55.57,
  "end": 57.13
 },
 {
  "text": "사임 나흘 만에 파이낸셜타임스가,",
  "start": 57.68,
  "end": 59.99
 },
 {
  "text": "황이 복귀를 논의하고 있다고 보도한 건데요.",
  "start": 60.28,
  "end": 62.83
 },
 {
  "text": "반면 베선트 재무장관은,",
  "start": 63.38,
  "end": 65.11
 },
 {
  "text": "외부에서 후임을 찾아야 한다며 선을 그었습니다.",
  "start": 65.35,
  "end": 68.25
 },
 {
  "text": "관건은 이번 주 실적 발표입니다.",
  "start": 68.8,
  "end": 71.04
 },
 {
  "text": "젠슨 황,",
  "start": 71.59,
  "end": 72.24
 },
 {
  "text": "다시 돌아올 수 있을까요?",
  "start": 72.63,
  "end": 73.87
 },
 {
  "text": "여러분 생각은 댓글로 남겨 주세요.",
  "start": 74.42,
  "end": 76.481
 }
]